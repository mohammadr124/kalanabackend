```gitignore
# Dependencies
node_modules/

# Build output
dist/
build/

# Logs
logs/
*.log
npm-debug.log*
yarn-debug.log*
pnpm-debug.log*

# Runtime data
pids/
*.pid
*.seed
*.pid.lock

# Coverage
coverage/

# TypeScript
*.tsbuildinfo

# IDEs and editors
.vscode/
.idea/
*.swp
*.swo

# Operating system
.DS_Store
Thumbs.db
desktop.ini

# Temporary files
tmp/
temp/

# Uploads and user files
uploads/*
!uploads/.gitkeep

# Local database files
*.sqlite
*.db
